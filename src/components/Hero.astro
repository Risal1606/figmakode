---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import CEOImage from "@assets/images/ceo.webp";
---

<section class="hero">
  <div class="hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow">Business consulting</p>
      <h1 class="hero__title">Empowering Your Business Growth</h1>
      <p class="hero__text">
        Discover tailored strategies and expert insights to take your business
        to the next level. Let us help you navigate challenges and achieve
        sustainable success.
      </p>

      <div class="hero__actions">
        <a href="#0" class="button button--primary">Book a Meeting</a>
        <a href="#0" class="button button--secondary">Learn More</a>
      </div>
    </div>

    <div class="hero__media">
      <Image src={CEOImage} alt="CEO" class="hero__image" />
    </div>
  </div>

  <Services />
</section>
