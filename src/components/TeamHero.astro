<section class="team-hero">
  <div class="team-hero-inner">
    <p class="team-hero-label">TEAM</p>
    <h1 class="team-hero-heading">The Consultors</h1>
    <div class="team-hero-line"></div>
    <p class="team-hero-body">
      Our success stems from the synergy between dedicated teams and our
      valued clients. We prioritize a company culture that fosters exceptional
      productivity, ensures customer satisfaction.
    </p>
  </div>
</section>

<style>
  .team-hero {
    background: #f7f7f8;
    padding: 80px 32px 100px;
    text-align: center;
  }

  .team-hero-inner {
    max-width: 600px;
    margin: 0 auto;
  }

  .team-hero-label {
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #888;
    margin: 0 0 16px;
    font-family: system-ui, sans-serif;
  }

  .team-hero-heading {
    font-size: 3rem;
    font-weight: 800;
    color: #111;
    margin: 0 0 0;
    font-family: "Georgia", serif;
    line-height: 1.1;
  }

  .team-hero-line {
    width: 100%;
    height: 3px;
    background: #f5c227;
    margin: 16px 0 40px;
  }

  .team-hero-body {
    font-size: 0.9rem;
    color: #555;
    line-height: 1.75;
    margin: 0;
    font-family: system-ui, sans-serif;
  }
</style>
