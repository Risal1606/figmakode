---
import employeeData from "../data/employees.json";
---

<section class="team-grid-section">
  <div class="team-grid-inner">
    <!-- Header -->
    <div class="team-grid-header">
      <div class="team-grid-header-left">
        <h2 class="team-grid-heading">Meet Our Great Team</h2>
        <p class="team-grid-body">
          Welcome to our amazing team! We are a group of passionate individuals
          dedicated to excellence and innovation. Each member brings unique
          skills and experiences, working together to achieve our goals. Join us
          as we embark on exciting projects and create lasting impacts.
        </p>
      </div>
      <a href="/contact" class="team-grid-btn">Join our team</a>
    </div>

    <!-- Grid -->
    <div class="team-grid">
      {
        employeeData.map((employee) => (
          <article class="team-card">
            <a
              href={`/team/${employee.id}`}
              class="team-card-img-wrap team-card-img-link"
              aria-label={`View ${employee.name}`}
            >
              <img
                src={employee.img}
                alt={employee.name}
                class="team-card-img"
              />
              <span class="team-card-badge">{employee.title}</span>
            </a>

            <h3 class="team-card-name">
              <a href={`/team/${employee.id}`} class="team-card-name-link">
                {employee.name}
              </a>
            </h3>

            <p class="team-card-desc">{employee.description}</p>

            <div class="team-card-socials">
              {employee.social_links.map((link) => (
                <a
                  href={link.url}
                  class="team-card-social"
                  aria-label={link.platform}
                >
                  {link.platform === "instagram" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="22"
                      height="22"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                      <circle cx="12" cy="12" r="4" />
                      <circle
                        cx="17.5"
                        cy="6.5"
                        r="0.8"
                        fill="currentColor"
                        stroke="none"
                      />
                    </svg>
                  )}
                  {link.platform === "facebook" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="22"
                      height="22"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                    </svg>
                  )}
                </a>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .team-grid-section {
    padding: 64px 0 80px;
    background: var(--color-surface-primary);
  }

  .team-grid-inner {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 var(--space-xl);
  }

  .team-grid-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    margin-bottom: var(--space-2xl);
  }

  .team-grid-header-left {
    max-width: 500px;
  }

  .team-grid-heading {
    font-size: 1.9rem;
    font-weight: 800;
    color: var(--color-ink);
    margin: 0 0 var(--space-sm);
    font-family: "Georgia", serif;
  }

  .team-grid-body {
    font-size: 0.8rem;
    color: var(--color-slate);
    line-height: 1.7;
    margin: 0;
    font-family: system-ui, sans-serif;
  }

  .team-grid-btn {
    display: inline-block;
    background: var(--color-action);
    color: var(--color-surface-primary);
    font-size: 0.8rem;
    font-weight: 500;
    padding: var(--space-sm) 26px;
    border-radius: var(--radius-round);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    font-family: system-ui, sans-serif;
    transition: background-color var(--transition-fast);
  }

  .team-grid-btn:hover {
    background: oklch(from var(--color-action) calc(l - 0.08) c h);
  }

  .team-grid-btn:active {
    background: oklch(from var(--color-action) calc(l - 0.14) c h);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2xl) var(--space-xl);
  }

  .team-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .team-card-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin-bottom: var(--space-md);
  }

  .team-card-img-link {
    display: block;
    text-decoration: none;
  }

  .team-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .team-card-badge {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: var(--color-ink);
    color: var(--color-surface-primary);
    font-size: 0.7rem;
    font-weight: 500;
    padding: 5px var(--space-sm);
    border-radius: var(--radius-round);
    font-family: system-ui, sans-serif;
  }

  .team-card-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 var(--space-xs);
    font-family: "Georgia", serif;
  }

  .team-card-name-link {
    color: inherit;
    text-decoration: none;
  }

  .team-card-name-link:hover {
    text-decoration: underline;
  }

  .team-card-desc {
    font-size: 0.78rem;
    color: var(--color-slate);
    line-height: 1.6;
    margin: 0 0 14px;
    font-family: system-ui, sans-serif;
  }

  .team-card-socials {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
  }

  .team-card-social {
    color: var(--color-ink);
    display: flex;
    align-items: center;
    transition: opacity 0.2s;
  }

  .team-card-social:hover {
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .team-grid-header {
      flex-direction: column;
    }
  }

  @media (max-width: 480px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
